---
import { AVAILABLE_LANG, useLocale } from "~/i18n";
import RootLayout from "@/layouts/RootLayout.astro";
import { AIRPORT_BRANDS } from "@/data/airports";
import Link from "@/components/ui/Link.astro";
import CouponBadge from "@/components/airports/CouponBadge.astro";
import PillarCapsuleNav from "@/components/ui/PillarCapsuleNav.astro";

export async function getStaticPaths() {
  return AVAILABLE_LANG.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || "zh-Hans";

const pageTitle =
  currentLang === "zh-Hans"
    ? "【2025-2026】机场进阶排障与出海翻墙技术 FAQ 圣经：晚高峰卡顿、ChatGPT 1020、TUN模式冲突与协议全景解析 - protonVPN"
    : currentLang === "ja-JP"
    ? "【2025-2026】プロキシ空港・VPNトラブルシューティング完全FAQ：夜間遅延、ChatGPT 1020エラー、TUN競合、プロトコル徹底解説 - protonVPN"
    : "Comprehensive Proxy & VPN Troubleshooting FAQ Monograph (2025-2026): Peak Congestion, ChatGPT 1020, TUN Conflicts & Protocols - protonVPN";

const pageDescription =
  currentLang === "zh-Hans"
    ? "超万字专著级排障百科，全面解答 40+ 个出海翻墙高频核心痛点与疑难问答。涵盖 Shadowsocks / VLESS-Reality / Hysteria2 协议底层对比、千兆晚高峰测速与真实丢包玄学、ChatGPT 1020 报错与 Claude 封号根治、Clash TUN 虚拟网卡路由竞争冲突排查、WebRTC 真实 IP 泄漏防护与节点倍率扣费陷阱。"
    : currentLang === "ja-JP"
    ? "40以上のプロキシトラブルシューティングQ&Aを網羅した万字級完全ガイド。VLESS/Hysteria2比較、ピーク時のパケットロス対策、ChatGPT 1020解除、TUN仮想アダプタ競合解決、WebRTC漏洩防止。"
    : "Master-level 10,000+ words troubleshooting encyclopedia covering 40+ core proxy pain points: protocol architectures, peak hour buffer troubleshooting, ChatGPT 1020 fixes, TUN routing conflicts, and WebRTC IP leak audits.";

const getBrandBySlug = (slug: string) => AIRPORT_BRANDS.find((b) => b.slug === slug);
const guangsu = getBrandBySlug("guangsu") || AIRPORT_BRANDS[0];
const xifeng = getBrandBySlug("xifeng");
const tengyun = getBrandBySlug("tengyun");
const laogou = getBrandBySlug("laogou");

// 40 Structured FAQ Entries grouped across 5 modules
const faqModules = [
  {
    moduleId: "protocols",
    moduleTitle: "模块一：网络链路、加密特征与底层协议对抗篇",
    moduleBadge: "协议底层",
    items: [
      {
        q: "Q1.1 VLESS-Reality、Shadowsocks、Hysteria2 与 Trojan 之间有什么本质物理差异？如何选型？",
        a: "四者在传输层协议、加密伪装逻辑与适用场景上有着清晰的代际差异：\n1. Shadowsocks (SS)：全对称流加密，数据包无明文特征。但因全熵特征过于明显，在公网直连线路上极易被防火墙主动探测识别封锁；而在企业级 IEPL 陆地内网专线内部，因不经过公网探测网关，其 CPU 占用极低、握手极简的特性反而能爆发出最高吞吐，是专线内网的首选承载协议。\n2. VLESS (XTLS-Reality)：现代化无状态流式转发协议，移除了多余的加密包装，核心杀手锏是 Reality 证书借用技术。客户端可借用苹果、微软、雅虎等全球巨头的合法证书与 SNI 伪装，阻断审查系统的主动嗅探探测，是目前公网中继和优质专线中最稳定、兼具超高安全与超低握手延迟的现代化协议。\n3. Hysteria 2：基于 UDP / QUIC 协议重构，搭载定制的 Brutal 拥塞控制算法。在恶劣丢包网络（丢包率 20%~40%）中绝不退让减速，而是强行多倍发包打满带宽，是公网弱网环境的暴力救星；但在对 UDP 严格 QoS 限速的运营商下表现可能劣化。\n4. Trojan：将流量完整伪装成标准的 HTTPS (TLS) Web 请求，伪装度高、兼容性极好，但由于需要两端完整进行 TLS 证书解密与重封装，CPU 资源消耗略高于 VLESS。\n选型建议：主力使用支持 VLESS-Reality 的专线或公网中继；若使用光速云等纯 IEPL 专线则 SS 与 VLESS 均可；弱网备用切换至 Hysteria 2。"
      },
      {
        q: "Q1.2 为什么 Hysteria 2 在部分省份运营商宽带下晚高峰会遭遇严重断流与限速？",
        a: "Hysteria 2 的核心传输介质是 UDP 协议。在中国大陆部分省份的本地宽带运营商（尤其是部分地区的中国移动与中国电信小宽带）中，为了防止 P2P 盗跑带宽与 UDP 泛洪攻击，在城域网及骨干出口部署了严苛的「UDP QoS 限速策略」：\n1. 运营商防火墙在检测到单 IP 对境外未知端口持续产生高并发、大吞吐的 UDP 流量超过 3~5 分钟后，会触发动态流控机制，直接丢弃后续 50%~80% 的 UDP 数据包，甚至临时将该 UDP 端口进行 10 分钟静默阻断。\n2. 解决方案：在客户端配置中为 Hysteria 2 启用端口跳跃（Port Hopping）功能，让连接在多个备用端口之间动态切换；或者在晚高峰宽带 QoS 严重的地区，主动将代理协议切换回基于 TCP / TLS 的 VLESS-Reality 或正规 IEPL 专线通道。"
      },
      {
        q: "Q1.3 什么是 BGP 隧道中转与 IEPL 陆地内网专线？为什么专线能做到 0% 晚高峰丢包？",
        a: "这是民用网络与企业级网络最关键的物理分水岭：\n1. BGP 隧道中转：用户流量首先连接境内的 BGP 入口机房（具备电信、联通、移动多线智能选路能力），随后通过公网加密隧道将数据转发至境外的落地服务器。虽然入口体验好，但中间段仍然经过公网国际海缆出口，晚高峰依然可能遭遇公网拥堵和丢包。\n2. IEPL (International Ethernet Private Line) 国际以太网陆地专线：是跨国电信运营商直接拉通的物理专用点对点光纤内网。用户流量在进入境内机房后，直接进入企业级内网通道，在完全隔离的陆地专用光缆中穿透至香港或日本机房。全程完全不过公网国际出口局防火墙（不过墙），不受公网骨干网络高峰拥塞影响。因此，像光速云这种采用纯双专线架构的机场，晚高峰丢包率能够长期稳定在 0.0%，Ping 延迟恒定抖动小于 2ms。"
      },
      {
        q: "Q1.4 什么是 TLS 握手特征与 JA3/JA4 指纹探测？防火墙如何识别未经优化的代理？",
        a: "现代网络安全审查已经从单纯的“阻断 IP / 域名”进化到深度“客户端指纹识别”阶段：\n1. 当你使用浏览器或代理客户端发起 TLS 加密连接时，首先会发送一个 `Client Hello` 数据包。该数据包中包含客户端支持的密码套件（Cipher Suites）、扩展列表（Extensions）以及椭圆曲线等参数，其排列顺序组合在一起，就能生成一个唯一的特征哈希值，称为 JA3 / JA4 指纹。\n2. 如果你使用的是老旧、粗制滥造的第三方开源代理客户端，其底层使用的 Go 语言或 Python 默认网络库发出的 TLS Client Hello 指纹与 Chrome、Safari 等主流商业浏览器存在极其显著的差异。审查系统无需解密数据包内容，仅凭这一指纹特征即可断定“这是一个非正常的翻墙程序”，进而下发 RST 阻断指令。\n3. 解决方案：选用基于现代内核（如 Mihomo / Xray / Sing-box）的客户端，并开启 UTLS 特性，将客户端的 TLS 指纹随机伪装成真实的 `chrome_auto` 或 `firefox` 商业浏览器指纹。"
      },
      {
        q: "Q1.5 为什么同一个节点在手机（小火箭/Clash）上秒开，在电脑端却完全超时超时打不开？",
        a: "同一个代理节点跨设备表现完全不同，通常由以下 4 个原因导致：\n1. 接入网络物理环境不同：手机往往处于 5G/4G 蜂窝网络（移动网络出口对部分国外 IP 路由较好），而电脑连接的是家庭电信/联通光纤宽带，不同运营商的国际出口路由策略存在巨大差异。\n2. 电脑端安全防护软件拦截：Windows Defender、第三方杀毒软件（360、火绒、迈克菲）或企业安全管控客户端将本地代理内核的监听端口（如 7890、10808）静默拦截，或者误杀了 `mihomo.exe` / `wintun.dll` 驱动。\n3. 系统代理与注册表死锁：Windows 系统代理开关在注册表中发生锁死，导致浏览器发出的请求没有正确流向客户端本地端口。\n4. 系统时间偏差：电脑端主板电池老化或未开启自动网络时间同步，系统时钟与国际标准时间（NTP）偏差超过 60 秒，导致加密协议握手认证失败。"
      },
      {
        q: "Q1.6 机场的“单端口多用户”与“多端口独立部署”架构在安全与抗封锁上有何区别？",
        a: "这是衡量机场服务端运维技术实力的隐形指标：\n1. 单端口多用户（Single Port Multi-User）：机场在服务端仅开放一个端口（如 443），所有付费用户通过同一个端口接入，由服务端根据用户订阅的 UUID / 鉴权码在内存中进行路由分发。优势是伪装度极高，像极了正常的大型 Web 门户，且极大节省宿主机端口资源。\n2. 多端口独立部署（Multi-Port）：每一个用户或每一组节点分配一个独立的冷门端口（如 23456、54321）。劣势极其明显：大量非标准高位端口在公网上极易被网络测绘引擎（Shodan）快速扫描发现，且一旦某个端口被安全网关重点监控，极易引发整台 VPS 被批量封禁端口。\n安全评定：正规老牌专线机场（如光速云、西风）全面采用单端口 443 标准伪装与企业内网路由调度，具备极强的抗封锁韧性。"
      },
      {
        q: "Q1.7 为什么 Shadowsocks 协议运行在 IEPL 专线内部反而是最理想的高性能选择？",
        a: "很多对技术一知半解的用户认为“Shadowsocks 已经落伍了，现在必须用 VLESS 才是高级”。这是一种典型的场景错配：\n1. Shadowsocks 之所以在公网被抛弃，唯一的原因是它无法防御公网主动探测。但如果在 **IEPL 纯内网专线** 中运行，外部审查系统根本无法触及内网流量，主动探测风险完全不存在。\n2. 在剥离了伪装诉求后，Shadowsocks 协议的物理优势无可匹敌：协议头极其微小（开销通常仅有几十字节），采用原生 AES-256-GCM 或 ChaCha20 对称流加密，主流 CPU 均具备硬件指令集加速，加解密速度比嵌套了多层 TLS 握手的复杂协议快数倍，且内存与 CPU 占用极低。在千兆压测下，Shadowsocks 在专线内能压榨出极致的低延迟与满血吞吐。"
      },
      {
        q: "Q1.8 什么是前向保密（Forward Secrecy）？为什么老旧的 VMess 协议正在被主流大机场退役？",
        a: "1. 所谓前向保密（Forward Secrecy），是指每次通信会话均生成临时的临时对称密钥，即使攻击者在事后获取了服务端的长期主私钥，也绝对无法解密回溯之前截获并存储的历史通信流量。\n2. 早期广泛流行的 VMess 协议设计于 2015 年，其核心加密方案依赖于固定的用户 UUID 与时间戳哈希校验，不具备完整的前向保密能力。随着算力提升与特征指纹技术的突破，VMess 的握手头部特征已被防火墙精准提取，且高并发下服务端 CPU 算力开销过大。\n3. 现状：2025 年起，业内成熟的主流机场已全面转向以 VLESS-Reality、Trojan 和专线 Shadowsocks 为核心的架构，老旧的 VMess 仅作为极少数旧系统路由器固件的兼容性备用通道逐步退出历史舞台。"
      }
    ]
  },
  {
    moduleId: "speed-latency",
    moduleTitle: "模块二：晚高峰拥堵、测速玄学与带宽损耗篇",
    moduleBadge: "晚高峰测速",
    items: [
      {
        q: "Q2.1 为什么千兆宽带单线程测速只有 10Mbps，而多线程测速却能跑满千兆？",
        a: "单线程与多线程测速揭示了完全不同的网络真实性能：\n1. 多线程测速（如 Speedtest 默认模式）：客户端同时向服务器发起 16~32 条 TCP 并发连接，将各条连接的瞬时下行带宽叠加求和。多线程掩盖了单条链路的丢包与抖动，即使单条连接严重卡顿，多条并发依然能在测速图上跑出漂亮的高分“虚标跑分”。\n2. 单线程测速（如 Fast.com 默认单连接、YouTube 4K 播放、大文件单一下载）：客户端仅维持一条 TCP 管道。根据 TCP 拥塞控制数学模型，单连接的最大传输速率由「往返时延（RTT）」与「丢包率（Packet Loss）」严格决定。一旦网络丢包率达到 2%~5%，单线程的 TCP 传输窗口就会被强行腰斩压制，导致即便千兆宽带，单线程速率也暴跌至 10Mbps 甚至更低。\n3. 核心启示：日常刷视频、看 4K 流媒体主要依赖单线程性能。看机场评测必须认准单线程测速表现（如光速云单节点突破 2.5Gbps 的实测指标）。"
      },
      {
        q: "Q2.2 为什么测速跑出了 500Mbps 漂亮高分，但看 YouTube 依然频繁转圈、码率只有 1 万？",
        a: "测速高分与实际视频卡顿的矛盾，通常由以下 3 个核心技术瓶颈造成：\n1. 测速节点与流媒体落地服务器物理链路脱节：测速工具连接的是位于香港或新加坡某测速机房的 Speedtest 探针服务器；而你在观看 YouTube 时，流量从机场节点到达 Google 全球视频缓存节点（GGC）的过程中，存在严重的跨网传输延迟或被流媒体限速。\n2. Google QUIC 协议在公网被 UDP 限速：现代 YouTube 客户端默认使用基于 UDP 的 QUIC 协议传输视频。如果你使用的节点在传输 UDP 时遭遇本地运营商 QoS 丢包，视频播放器就会频繁卡顿退让。解决方案：在浏览器中禁用 QUIC 协议（在 chrome://flags 中将 Experimental QUIC protocol 设为 Disabled），强制其退回稳定的 TCP 加密传输。\n3. 客户端 Fake-IP 与本地 DNS 缓存混乱：视频切片请求被分流策略错误地解析到地球另一端的非就近 CDN 节点，导致每一个 4K 切片的加载延迟高达数百毫秒。"
      },
      {
        q: "Q2.3 TCP 拥塞控制算法 BBR（v1/v2/v3）与 CUBIC 如何影响视频起步与抗丢包表现？",
        a: "拥塞控制算法是决定长距离跨境网络传输效率的核心引擎：\n1. 传统 CUBIC 算法（基于丢包驱动）：只要链路发生丢包，CUBIC 就会盲目认为“网络发生堵塞”，立刻将发送窗口削减 30%~50%，进入缓慢爬坡恢复期。在跨国跨海网络中，很多丢包是物理信道微弱抖动引起的，CUBIC 会导致带宽长期无法跑满，表现为看视频起步极慢、进度条拖动后长时间缓冲。\n2. Google BBR 算法（基于瓶颈带宽和往返时间驱动）：BBR 不再以丢包作为唯一的降速依据，而是实时探测链路的物理最大吞吐能力与最小 RTT 往返延迟。即使发生轻微丢包，BBR 依然能以最大可用带宽持续高速发包。\n3. 实战建议：优质商业机场的海外出口节点全部在 Linux 内核层深度调优并启用了 BBR 算法，能使视频起步缓冲时间缩短至 0.5 秒以内，拖动进度条丝滑秒开。"
      },
      {
        q: "Q2.4 什么是节点“倍率陷阱”（0.1x vs 1.0x vs 3.0x）？如何防范天价流量被暗中扣除？",
        a: "节点倍率是机场计费系统中极其重要但极容易被新手忽略的商业规则：\n1. 什么是倍率：你在该节点实际消耗的物理流量乘以节点倍率，才是从你套餐账户中扣除的计费流量。公式为：`扣除流量 = 实际传输流量 × 节点倍率`。\n2. 0.1x 节点（超低倍率）：你下载了 10GB 文件，后台仅扣除 1GB 套餐流量。通常为公网直连或冷门备份线路，适合用来挂机挂种子或下载超大型文件。\n3. 1.0x 节点（标准倍率）：传 1GB 扣 1GB，绝大多数日常专线与主力节点采用此标准。\n4. 3.0x~5.0x 节点（高倍率特种专线）：多用于极其昂贵的纯原生住宅 IP 节点、企业超高清直播推流专线或低延迟游戏加速节点。你若用 3.0x 节点看了一场 4K 电影（消耗 20GB），账户将被瞬间扣除 60GB 额度！\n防范建议：使用客户端（如 Clash Verge Rev）时，留意节点名称前缀标注的倍率标签，严禁使用高倍率节点挂载后台自动化同步网盘或下载大文件。"
      },
