}

const { lang } = Astro.params;
const currentLang = lang || "zh-Hans";

// Extract brands
const top10Airports = AIRPORT_BRANDS.slice(0, 10);
const guangsu = AIRPORT_BRANDS[0];
const xifeng = AIRPORT_BRANDS[1];
const tengyun = AIRPORT_BRANDS[2];
const jifeng = AIRPORT_BRANDS[3];
const wuyou = AIRPORT_BRANDS[13];
const youtu = AIRPORT_BRANDS[5];
const laogou = AIRPORT_BRANDS.find((b) => b.slug === "laogou") || AIRPORT_BRANDS[27];

// SEO Metadata
const homeTitle =
  currentLang === "zh-Hans"
    ? "42家主流机场梯子深度测评与科学上网选购指南 (2025-2026晚高峰真机测速雷达) - protonVPN"
    : currentLang === "ja-JP"
    ? "42社プロキシ空港・VPN実機スピードテスト＆徹底比較ガイド (2025-2026最新) - protonVPN"
    : "42 Proxy Airports Benchmark & Comprehensive Buyer's Guide (2025-2026) - protonVPN";

const homeDescription =
  currentLang === "zh-Hans"
    ? "protonVPN 评测实验室基于千兆家庭光纤晚高峰（20:00~23:00）真实环境压测，深度评测 42 家主流机场梯子。涵盖光速云 2.5Gbps IEPL 专线旗舰、西风、腾云、便宜平价与永久不限时套餐对比，提供底层专线技术解析、全平台客户端（Clash/小火箭）分流配置与避坑决策指南。"
    : currentLang === "ja-JP"
    ? "家庭用1000Mbps光回線を用い、夜間混雑ピーク時の42社プロキシ空港を徹底比較。光速雲2.5Gbps IEPL専用線、料金プラン、全OS対応クライアント導入法、AI・動画ブロック解除マトリクスを完全網羅。"
    : "Benchmark of 42 top proxy airports & VPNs by protonVPN Lab. Real peak-hour speedtests, IEPL dedicated line architecture, streaming/AI unlock matrix, and cross-platform client setup guides.";
---

<RootLayout title={homeTitle} description={homeDescription}>
  <header slot="header">
