                </tr>
              </thead>
              <tbody>
                {top10Airports.map((airport, idx) => (
                  <tr class={idx === 0 ? "tr-champion-row" : ""}>
                    <td class="td-sticky">
                      <div class="brand-cell">
                        <span class={`rank-tag ${idx === 0 ? "rank-1" : idx < 3 ? "rank-top3" : ""}`}>
                          #{airport.rank}
                        </span>
                        <Link href={`/${currentLang}/airports/${airport.slug}`} class="brand-link-table">
                          <strong>{airport.name}</strong>
                        </Link>
                        {idx === 0 && <span class="tag-c">C位推荐</span>}
                      </div>
                    </td>
                    <td class="td-price">
                      <strong>{airport.startingPrice}</strong>
                    </td>
                    <td>{airport.billingCycleType}</td>
                    <td>
                      <span class="badge-line-type">{airport.lineType.split("（")[0]}</span>
                    </td>
                    <td class="td-mono">{airport.protocols.slice(0, 2).join("/")}</td>
                    <td class="td-speed">{airport.maxBandwidth || "800Mbps+"}</td>
