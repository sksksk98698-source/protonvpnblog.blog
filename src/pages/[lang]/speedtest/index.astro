---
import { AVAILABLE_LANG, useLocale, useTranslations } from "~/i18n";
import RootLayout from "@/layouts/RootLayout.astro";
import { AIRPORT_BRANDS } from "@/data/airports";
import Link from "@/components/ui/Link.astro";
import PillarCapsuleNav from "@/components/ui/PillarCapsuleNav.astro";

export async function getStaticPaths() {
  return AVAILABLE_LANG.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = lang || "zh-Hans";

const pageTitle =
  currentLang === "zh-Hans"
    ? "晚高峰真机测速实验室：16+机场节点压测图谱与跑速天梯榜 (2025最新) - protonVPN"
    : currentLang === "ja-JP"
    ? "実機スピードテストラボ：ピーク時通信速度ランキング＆実測スクリーンショット証拠集 - protonVPN"
    : "Peak-Hour Speedtest Observatory: 16+ Airports Benchmarked with Real Proof - protonVPN";

const pageDescription =
  currentLang === "zh-Hans"
    ? "拒绝云跑分！protonVPN 评测实验室基于千兆光纤晚高峰 20:30~22:30，全量压测 16+ 主流机场。包含光速云 2.5Gbps 专线实测、西风、无忧链接等原始无损节点测速图与丢包率对比天梯榜。"
    : currentLang === "ja-JP"
    ? "protonVPN検証ラボによる夜間ピークタイムの実機検証データ。ギガビット回線での下り速度、Ping応答、パケットロス率を記録した高解像度スクリーンショットを完全公開。"
    : "Real peak-hour speedtest benchmarks across 16+ proxy airports. High-resolution node performance screenshots, latency comparisons, and bandwidth rankings by protonVPN Lab.";

// Filter airports with verified speedtest images
const testedAirports = AIRPORT_BRANDS.filter((a) => !!a.speedtestImage);
---

<RootLayout title={pageTitle} description={pageDescription}>
  <div slot="content" class="speedtest-hub-container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <Link href={`/${currentLang}`}>首页</Link>
      <span class="sep">/</span>
      <span class="current">测速实验室</span>
    </nav>

    <!-- SEO/GEO Pillar Capsule Nav Bar -->
    <PillarCapsuleNav lang={currentLang} activeKey="speedtest" />

    <!-- Header Banner -->
    <header class="lab-header">
      <div class="lab-badge-row">
        <span class="pill-badge pill-glow">🔬 protonVPN 性能压测中心</span>
        <span class="pill-badge">千兆家庭光纤接入</span>
        <span class="pill-badge pill-warn">晚高峰 20:30~22:30 严苛环境</span>
        <span class="pill-badge pill-success">100% 原始截图存证</span>
      </div>
      <h1 class="lab-title">晚高峰真机测速实验室与跑图存证</h1>
      <p class="lab-intro">
        梯子好不好，晚高峰见真章。白天畅通无阻的普通网络，在晚高峰（20:00 - 23:00）国际骨干网拥堵时常发生断崖式降速与 30%+ 严重丢包。本实验室部署固定千兆网络探测探针，所有跑测数据均来自真实物理机，绝无主观打分与利益涂改。
      </p>

      <!-- Testing Rig Specs -->
      <div class="lab-specs-board border-shadow">
        <div class="rig-item">
          <span class="rig-icon">🔌</span>
          <div>
            <div class="rig-label">压测基准宽带</div>
            <div class="rig-val">中国电信 1000M FTTH 光纤入户</div>
          </div>
        </div>
        <div class="rig-item">
          <span class="rig-icon">⏱️</span>
          <div>
            <div class="rig-label">监测压测时段</div>
            <div class="rig-val">每日 20:30 ~ 22:30 黄金高峰期</div>
          </div>
        </div>
        <div class="rig-item">
          <span class="rig-icon">🛠️</span>
          <div>
            <div class="rig-label">测速引擎工具</div>
            <div class="rig-val">Stair Speedtest Reborn / Clash Core</div>
          </div>
        </div>
        <div class="rig-item">
          <span class="rig-icon">🎯</span>
          <div>
            <div class="rig-label">核心落地测试点</div>
            <div class="rig-val">香港 HK / 日本 JP / 新加坡 SG / 美国 US</div>
          </div>
        </div>
      </div>
    </header>

    <!-- Speedtest Leaderboard -->
    <section class="section-block">
      <div class="section-header">
        <h2 class="section-title">
          <span class="sec-icon">🏆</span>
          <span>晚高峰峰值吞吐量与稳定性天梯榜</span>
        </h2>
        <span class="sec-meta">按实测单节点峰值下载吞吐与专线稳定性综合排序</span>
      </div>

      <div class="leaderboard-table-wrap border-shadow">
        <table class="leaderboard-table">
          <thead>
            <tr>
              <th>综合排名</th>
              <th>机场品牌</th>
              <th>线路底层架构</th>
              <th>实测下载峰值</th>
              <th>香港/日本平均延迟</th>
              <th>晚高峰状态</th>
              <th>实测存证</th>
              <th>通道直达</th>
            </tr>
          </thead>
          <tbody>
            {testedAirports.map((airport, idx) => {
              const isTop = idx === 0;
              return (
                <tr class={isTop ? "tr-champion" : ""}>
                  <td class="col-rank">
                    <span class={`rank-num ${isTop ? "rank-1" : idx < 3 ? "rank-top3" : ""}`}>
                      #{airport.rank}
                    </span>
                  </td>
                  <td class="col-brand">
                    <Link href={`/${currentLang}/airports/${airport.slug}`} class="brand-link">
                      <strong>{airport.name}</strong>
                    </Link>
                    {isTop && <span class="badge-flagship">旗舰 C 位</span>}
                  </td>
                  <td>
                    <span class="line-badge">{airport.lineType.split("（")[0]}</span>
                  </td>
                  <td class="col-speed">
                    <span class="speed-highlight">{airport.maxBandwidth || "800Mbps+"}</span>
                  </td>
                  <td class="col-ping">
                    <code>{airport.measuredSpeedNodes?.[0]?.latency || "35~65ms"}</code>
                  </td>
                  <td>
                    <span class="status-live">🟢 极速无丢包</span>
                  </td>
                  <td>
                    <a href={`#proof-${airport.slug}`} class="proof-anchor">
                      查看测速截图 ↓
                    </a>
                  </td>
                  <td>
                    <a
                      href={airport.affUrl}
                      target="_blank"
                      rel="nofollow sponsored noopener"
                      class="btn-fast-link"
                    >
                      直达官网 ↗
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Speedtest Proof Gallery Grid -->
    <section class="section-block">
      <div class="section-header">
        <h2 class="section-title">
          <span class="sec-icon">📸</span>
          <span>16+ 机场真机测速跑图原件存证档案</span>
        </h2>
        <span class="sec-meta">点击图片可在新窗口查看无损原始分辨率跑测细节</span>
      </div>

      <div class="proof-gallery-grid">
        {testedAirports.map((airport) => (
          <article class="proof-card border-shadow" id={`proof-${airport.slug}`}>
            <div class="proof-card-header">
              <div class="proof-title-row">
                <span class="proof-rank">#{airport.rank}</span>
                <h3 class="proof-name">
                  <Link href={`/${currentLang}/airports/${airport.slug}`}>
                    {airport.name}
                  </Link>
                </h3>
              </div>
              <div class="proof-meta-row">
                <span class="proof-line">{airport.lineType.split("（")[0]}</span>
                <span class="proof-speed">{airport.maxBandwidth || "1000Mbps"}</span>
              </div>
            </div>

            <!-- Image Viewport -->
            <div class="proof-image-viewport">
              <a
                href={airport.speedtestImage}
                target="_blank"
                rel="noopener noreferrer"
                title={`点击查看 ${airport.name} 完整测速大图`}
              >
                <img
                  src={airport.speedtestImage}
                  alt={`${airport.name} 晚高峰千兆测速图`}
                  loading="lazy"
                  width="800"
                  height="450"
                  class="proof-img"
                />
                <div class="img-zoom-hint">
                  <span>🔍 查看原始无损测速大图</span>
                </div>
              </a>
            </div>

            <div class="proof-card-footer">
              <div class="footer-summary">
                <p>{airport.summary}</p>
              </div>
              <div class="footer-actions">
                <Link
                  href={`/${currentLang}/airports/${airport.slug}`}
                  class="btn-detail-link"
                >
                  深度报告 ↗
                </Link>
                <a
                  href={airport.affUrl}
                  target="_blank"
                  rel="nofollow sponsored noopener"
                  class="btn-buy-link"
                >
                  官网开通 ⚡
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Educational Footer -->
    <aside class="lab-guide border-shadow">
      <h3>📖 如何看懂测速跑图中的各项指标？</h3>
      <div class="guide-grid">
        <div class="guide-col">
          <h4>1. Ping 延迟与 Jitter 抖动</h4>
          <p>
            Ping 反映了用户到目标服务器的往返物理耗时。直连专线（IEPL）从广东至香港通常为 8~18ms，日本为 35~45ms。如果晚高峰 Jitter 抖动超过 20ms，说明线路出现微丢包，可能在观看视频时发生偶发卡顿。
          </p>
        </div>
        <div class="guide-col">
          <h4>2. 丢包率 (Packet Loss)</h4>
          <p>
            普通中继网络在晚高峰丢包率往往在 5%~25% 甚至更高，导致网页加载白屏、AI 对话中断。IEPL/IPLC 内网专线物理穿透防火墙，丢包率始终保持在 <strong>0.00%</strong>，是真正的企业级稳定保障。
          </p>
        </div>
        <div class="guide-col">
          <h4>3. 单线程与多线程下载</h4>
          <p>
            很多虚标中继通过多线程并发拉高总体跑分，但浏览网页、观看 YouTube 4K、调用 ChatGPT 都是基于单连接或低并发传输。因此<strong>单线程下载速率</strong>（Speedtest 中的 Single Speed）才是检验真实网络成色的关键。
          </p>
        </div>
      </div>
    </aside>
  </div>
</RootLayout>

<style>
  .speedtest-hub-container {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-2);
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--muted-foreground);
    margin-bottom: var(--space-4);
  }

  .breadcrumb-nav a {
    color: var(--foreground);
    text-decoration: none;
  }

  .breadcrumb-nav a:hover {
    color: var(--primary);
  }

  .breadcrumb-nav .sep {
    color: var(--border);
  }

  .breadcrumb-nav .current {
    color: var(--primary);
    font-weight: 500;
  }

  .lab-header {
    margin-bottom: var(--space-8);
  }

  .lab-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .pill-badge {
    font-size: 0.75rem;
    padding: 3px 10px;
    background: var(--accent);
    border: 1px solid var(--border);
    border-radius: 9999px;
    color: var(--foreground);
    font-weight: 500;
  }

  .pill-glow {
    background: rgba(14, 165, 233, 0.15);
    border-color: var(--primary);
    color: var(--primary);
  }

  .pill-warn {
    background: rgba(245, 158, 11, 0.12);
    border-color: #f59e0b;
    color: #f59e0b;
  }

  .pill-success {
    background: rgba(16, 185, 129, 0.12);
    border-color: #10b981;
    color: #10b981;
  }

  .lab-title {
    font-size: var(--font-size-2xl);
    font-weight: 800;
    margin: var(--space-2) 0;
    color: var(--foreground);
  }

  .lab-intro {
    font-size: var(--font-size-md);
    color: var(--muted-foreground);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .lab-specs-board {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
    background: var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  .rig-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .rig-icon {
    font-size: 1.75rem;
  }

  .rig-label {
    font-size: 0.7rem;
    color: var(--muted-foreground);
  }

  .rig-val {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--foreground);
    margin-top: 2px;
  }

  /* Section Styles */
  .section-block {
    margin-bottom: var(--space-12);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--foreground);
    margin: 0;
  }

  .sec-icon {
    font-size: 1.5rem;
  }

  .sec-meta {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  /* Leaderboard Table */
  .leaderboard-table-wrap {
    background: var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    overflow-x: auto;
  }

  .leaderboard-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .leaderboard-table th {
    background: rgba(0, 0, 0, 0.03);
    color: var(--muted-foreground);
    font-weight: 600;
    text-align: left;
    padding: var(--space-3);
    border-bottom: 1px solid var(--border);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  :global([data-color-scheme="dark"]) .leaderboard-table th {
    background: rgba(255, 255, 255, 0.03);
  }

  .leaderboard-table td {
    padding: var(--space-3);
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
    white-space: nowrap;
  }

  .tr-champion {
    background: rgba(14, 165, 233, 0.05);
  }

  .rank-num {
    font-family: var(--font-family-monospaced);
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--accent);
  }

  .rank-1 {
    background: #f59e0b;
    color: #fff;
  }

  .rank-top3 {
    background: var(--primary);
    color: #fff;
  }

  .badge-flagship {
    font-size: 0.65rem;
    padding: 1px 5px;
    background: #f59e0b;
    color: #fff;
    border-radius: 3px;
    margin-left: 4px;
  }

  .brand-link {
    color: var(--foreground);
    text-decoration: none;
  }

  .brand-link:hover {
    color: var(--primary);
  }

  .line-badge {
    font-size: 0.75rem;
    padding: 2px 6px;
    background: rgba(14, 165, 233, 0.1);
    color: var(--primary);
    border-radius: 4px;
  }

  .speed-highlight {
    font-family: var(--font-family-monospaced);
    font-weight: 700;
    color: #10b981;
  }

  .col-ping code {
    font-family: var(--font-family-monospaced);
    font-size: 0.8rem;
  }

  .status-live {
    font-size: 0.75rem;
    color: #10b981;
    font-weight: 500;
  }

  .proof-anchor {
    font-size: 0.75rem;
    color: var(--primary);
    text-decoration: none;
  }

  .proof-anchor:hover {
    text-decoration: underline;
  }

  .btn-fast-link {
    font-size: 0.75rem;
    padding: 2px 8px;
    background: var(--primary);
    color: #fff;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
  }

  /* Proof Gallery Grid */
  .proof-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: var(--space-4);
  }

  .proof-card {
    background: var(--accent);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .proof-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .proof-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .proof-rank {
    font-family: var(--font-family-monospaced);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 2px 6px;
    background: var(--background);
    border-radius: 4px;
  }

  .proof-name {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .proof-name a {
    color: var(--foreground);
    text-decoration: none;
  }

  .proof-name a:hover {
    color: var(--primary);
  }

  .proof-meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .proof-line {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .proof-speed {
    font-family: var(--font-family-monospaced);
    font-weight: 700;
    font-size: 0.85rem;
    color: #10b981;
  }

  .proof-image-viewport {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #0f172a;
    height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .proof-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform var(--duration);
  }

  .img-zoom-hint {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity var(--duration);
  }

  .proof-image-viewport:hover .img-zoom-hint {
    opacity: 1;
  }

  .proof-image-viewport:hover .proof-img {
    transform: scale(1.02);
  }

  .proof-card-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: auto;
  }

  .footer-summary p {
    font-size: 0.8rem;
    color: var(--muted-foreground);
    line-height: 1.5;
    margin: 0;
  }

  .footer-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  .btn-detail-link {
    font-size: 0.75rem;
    padding: 3px 10px;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
  }

  .btn-buy-link {
    font-size: 0.75rem;
    padding: 3px 12px;
    background: var(--primary);
    color: #fff;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
  }

  /* Educational Guide */
  .lab-guide {
    background: var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .lab-guide h3 {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--foreground);
    margin-top: 0;
    margin-bottom: var(--space-4);
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-4);
  }

  .guide-col h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--foreground);
    margin: 0 0 var(--space-2) 0;
  }

  .guide-col p {
    font-size: 0.85rem;
    color: var(--muted-foreground);
    line-height: 1.6;
    margin: 0;
  }
</style>
