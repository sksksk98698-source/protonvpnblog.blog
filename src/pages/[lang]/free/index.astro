  .toc-link:hover {
    background: var(--accent, #f3f4f6);
    color: var(--primary, #0369a1);
    transform: translateX(3px);
  }

  :global([data-color-scheme="dark"]) .toc-link:hover {
    background: rgba(55, 65, 81, 0.8);
    color: var(--primary, #38bdf8);
  }

  .toc-link .num {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary, #0369a1);
    font-family: monospace;
  }

  :global([data-color-scheme="dark"]) .toc-link .num {
    color: var(--primary, #38bdf8);
  }

  /* Section Styles */
  .monograph-section {
    margin-bottom: 3.5rem;
    scroll-margin-top: 5rem;
  }

  .section-title-wrap {
    margin-bottom: 1.25rem;
  }

  .section-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary, #0369a1);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  :global([data-color-scheme="dark"]) .section-badge {
    color: var(--primary, #38bdf8);
  }

  .section-h2 {
    font-size: 1.45rem;
    font-weight: 800;
    line-height: 1.35;
    margin: 0;
    color: var(--foreground, #111827);
  }

  @media (min-width: 768px) {
    .section-h2 {
      font-size: 1.75rem;
    }
  }

  .section-h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 2rem 0 0.75rem 0;
    color: var(--foreground, #111827);
    padding-left: 0.5rem;
    border-left: 3px solid var(--primary, #0369a1);
  }

  :global([data-color-scheme="dark"]) .section-h3 {
    border-left-color: var(--primary, #38bdf8);
  }

  .text-block p {
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
    color: var(--foreground, #374151);
  }

  :global([data-color-scheme="dark"]) .text-block p {
    color: #d1d5db;
  }

  /* Direct Answer Banner */
  .direct-answer-banner {
    padding: 1.25rem;
    background: linear-gradient(135deg, rgba(3, 105, 161, 0.08) 0%, rgba(243, 244, 246, 0.8) 100%);
    border: 1px solid rgba(3, 105, 161, 0.2);
    border-radius: var(--radius-xl, 12px);
    margin-bottom: 1.5rem;
  }

  :global([data-color-scheme="dark"]) .direct-answer-banner {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.12) 0%, rgba(31, 41, 55, 0.8) 100%);
    border-color: rgba(56, 189, 248, 0.25);
  }

  .answer-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary, #0369a1);
    background: rgba(3, 105, 161, 0.15);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  :global([data-color-scheme="dark"]) .answer-badge {
    color: var(--primary, #38bdf8);
    background: rgba(56, 189, 248, 0.2);
  }

  .answer-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0.5rem 0 0.75rem 0;
  }

  .answer-desc {
    font-size: 0.925rem;
    line-height: 1.8;
    margin: 0;
    color: var(--foreground, #1f2937);
  }

  :global([data-color-scheme="dark"]) .answer-desc {
    color: #e5e7eb;
  }

  /* Master Comparison Table */
  .table-container-wrap {
    background: var(--background, #ffffff);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: var(--radius-xl, 12px);
    padding: 1rem;
    margin: 1.5rem 0;
  }

  :global([data-color-scheme="dark"]) .table-container-wrap {
    background: rgba(31, 41, 55, 0.6);
    border-color: rgba(75, 85, 99, 0.4);
  }

  .table-sub-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--muted-foreground, #4b5563);
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border, #e5e7eb);
  }

  .table-scroll-hint {
    font-size: 0.75rem;
    color: #e11d48;
  }

  .master-table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .monograph-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    text-align: left;
    min-width: 800px;
  }

  .monograph-table th,
  .monograph-table td {
    padding: 0.75rem 0.65rem;
    border-bottom: 1px solid var(--border, #e5e7eb);
    vertical-align: middle;
  }

  .monograph-table th {
    background: var(--accent, #f9fafb);
    font-weight: 700;
    color: var(--foreground, #111827);
    white-space: nowrap;
  }

  :global([data-color-scheme="dark"]) .monograph-table th {
    background: rgba(55, 65, 81, 0.7);
  }

  .th-sticky {
    position: sticky;
    left: 0;
    background: inherit;
    z-index: 1;
    min-width: 150px;
  }

  .row-danger {
    background: rgba(239, 68, 68, 0.04);
  }
  .row-warning {
    background: rgba(245, 158, 11, 0.04);
  }
  .row-info {
    background: rgba(59, 130, 246, 0.04);
  }
  .row-good {
    background: rgba(16, 185, 129, 0.04);
  }
  .row-champion {
    background: rgba(147, 51, 234, 0.07);
    font-weight: 600;
  }

  .sub-pill {
    display: inline-block;
    font-size: 0.7rem;
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    margin-top: 0.2rem;
  }
  .sub-pill.red { background: #fee2e2; color: #b91c1c; }
  .sub-pill.yellow { background: #fef3c7; color: #b45309; }
  .sub-pill.blue { background: #dbeafe; color: #1d4ed8; }
  .sub-pill.green { background: #d1fae5; color: #047857; }
  .sub-pill.purple { background: #f3e8ff; color: #6b21a8; }

  .val-danger { color: #dc2626; font-weight: 700; }
  .val-warn { color: #d97706; font-weight: 600; }
  .val-safe { color: #059669; font-weight: 600; }
  .val-elite { color: #7c3aed; font-weight: 700; }
  .highlight-val { color: #0284c7; font-weight: 800; }

  /* Threat Grid */
  .threat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  @media (min-width: 640px) {
    .threat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .threat-card {
    padding: 1.15rem;
    background: var(--background, #ffffff);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: var(--radius-lg, 8px);
  }

  :global([data-color-scheme="dark"]) .threat-card {
    background: rgba(31, 41, 55, 0.5);
    border-color: rgba(75, 85, 99, 0.4);
  }

  .threat-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }
  .threat-badge.red { background: #fee2e2; color: #b91c1c; }
  .threat-badge.yellow { background: #fef3c7; color: #b45309; }
  .threat-badge.blue { background: #e0f2fe; color: #0369a1; }

  .threat-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
  }

  .threat-desc {
    font-size: 0.85rem;
    color: var(--muted-foreground, #6b7280);
    line-height: 1.6;
    margin: 0;
  }

  /* Experiment & Rules Boxes */
  .exp-box {
    margin: 1.5rem 0;
    padding: 1.25rem;
    background: #fff1f2;
    border: 1px solid #fecdd3;
    border-radius: var(--radius-lg, 8px);
  }

  :global([data-color-scheme="dark"]) .exp-box {
    background: rgba(136, 19, 55, 0.2);
    border-color: rgba(225, 29, 72, 0.4);
  }

  .exp-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #9f1239;
    margin: 0 0 0.75rem 0;
  }

  :global([data-color-scheme="dark"]) .exp-title {
    color: #fda4af;
  }

  .exp-list {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.7;
    color: #881337;
  }

  :global([data-color-scheme="dark"]) .exp-list {
    color: #fecdd3;
  }

  .exp-list li {
    margin-bottom: 0.5rem;
  }

  .monograph-check-list,
  .monograph-bullet-list {
    padding-left: 1.25rem;
    margin: 1rem 0 1.5rem 0;
    font-size: 0.925rem;
    line-height: 1.8;
  }

  .monograph-check-list li,
  .monograph-bullet-list li {
    margin-bottom: 0.6rem;
  }

  .rules-box {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .rule-item {
    display: flex;
    gap: 0.75rem;
    padding: 0.85rem;
    background: var(--accent, #f9fafb);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: var(--radius-md, 6px);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  :global([data-color-scheme="dark"]) .rule-item {
    background: rgba(31, 41, 55, 0.5);
    border-color: rgba(75, 85, 99, 0.4);
  }

  .rule-icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  /* Terminal Card */
  .terminal-card {
    background: #0f172a;
    color: #38bdf8;
    border-radius: var(--radius-lg, 8px);
    padding: 1rem;
    margin: 1.5rem 0;
    font-family: monospace;
    font-size: 0.825rem;
  }

  .term-header {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #1e293b;
  }

  .term-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .term-dot.red { background: #ef4444; }
  .term-dot.yellow { background: #f59e0b; }
  .term-dot.green { background: #10b981; }

  .term-title {
    font-size: 0.75rem;
    color: #94a3b8;
    margin-left: 0.5rem;
  }

  .term-body code {
    display: block;
    line-height: 1.6;
    color: #e2e8f0;
  }

  .feature-tip-box {
    padding: 1rem;
    background: rgba(3, 105, 161, 0.05);
    border-left: 4px solid var(--primary, #0369a1);
    border-radius: 0 var(--radius-md, 6px) var(--radius-md, 6px) 0;
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 1.5rem 0;
  }

  /* Trials Grid */
  .trials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  @media (min-width: 640px) {
    .trials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .trial-card {
    padding: 1.25rem;
    background: var(--background, #ffffff);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: var(--radius-xl, 12px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  :global([data-color-scheme="dark"]) .trial-card {
    background: rgba(31, 41, 55, 0.6);
    border-color: rgba(75, 85, 99, 0.4);
  }

  .trial-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .trial-brand {
    font-size: 1.05rem;
    font-weight: 700;
  }

  .trial-tag {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }
  .trial-tag.green { background: #d1fae5; color: #047857; }
  .trial-tag.blue { background: #dbeafe; color: #1d4ed8; }
  .trial-tag.purple { background: #f3e8ff; color: #6b21a8; }
  .trial-tag.yellow { background: #fef3c7; color: #b45309; }

  .trial-detail {
    font-size: 0.825rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed var(--border, #e5e7eb);
  }

  .trial-row {
    display: flex;
    justify-content: space-between;
  }

  .trial-row .k { color: var(--muted-foreground, #6b7280); }
  .trial-row .v { font-weight: 600; text-align: right; }

  .trial-desc {
    font-size: 0.825rem;
    color: var(--muted-foreground, #6b7280);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .trial-btn-row {
    display: flex;
    gap: 0.5rem;
    margin-top: auto;
  }

  .btn-trial-aff {
    flex: 1;
    text-align: center;
    background: var(--primary, #0369a1);
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-md, 6px);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .btn-trial-aff:hover { opacity: 0.9; }

  .btn-trial-review {
    flex: 1;
    text-align: center;
    background: var(--accent, #f3f4f6);
    color: var(--foreground, #111827);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.45rem 0.65rem;
    border-radius: var(--radius-md, 6px);
    text-decoration: none;
  }

  /* SOP Steps */
  .sop-steps {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .sop-step-item {
    display: flex;
    gap: 1rem;
    padding: 1.15rem;
    background: var(--background, #ffffff);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: var(--radius-lg, 8px);
  }

  :global([data-color-scheme="dark"]) .sop-step-item {
    background: rgba(31, 41, 55, 0.5);
    border-color: rgba(75, 85, 99, 0.4);
  }

  .sop-num {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--primary, #0369a1);
    background: rgba(3, 105, 161, 0.1);
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius-md, 6px);
    height: fit-content;
    white-space: nowrap;
    font-family: monospace;
  }

  :global([data-color-scheme="dark"]) .sop-num {
    color: var(--primary, #38bdf8);
    background: rgba(56, 189, 248, 0.15);
  }

  .sop-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.35rem 0;
  }

  .sop-content p {
    font-size: 0.875rem;
    color: var(--muted-foreground, #6b7280);
    line-height: 1.6;
    margin: 0;
  }

  /* Math Model Box */
  .math-model-box {
    margin: 1.5rem 0;
    padding: 1.25rem;
    background: #fdf2f8;
    border: 1px solid #fbcfe8;
    border-radius: var(--radius-xl, 12px);
  }

  :global([data-color-scheme="dark"]) .math-model-box {
    background: rgba(131, 24, 67, 0.15);
    border-color: rgba(219, 39, 119, 0.3);
  }

  .model-title {
    font-size: 1rem;
    font-weight: 800;
    color: #9d174d;
    margin: 0 0 0.75rem 0;
  }

  :global([data-color-scheme="dark"]) .model-title {
    color: #f472b6;
  }

  .model-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    padding: 0.35rem 0;
    border-bottom: 1px dashed rgba(219, 39, 119, 0.2);
  }

  .model-total-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.5rem 0;
    color: #831843;
  }

  :global([data-color-scheme="dark"]) .model-total-row {
    color: #fbcfe8;
  }

  .model-final-calc {
    margin-top: 0.75rem;
    padding: 0.75rem;
    background: #ffffff;
    border-radius: var(--radius-md, 6px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.95rem;
    color: #9d174d;
  }

  :global([data-color-scheme="dark"]) .model-final-calc {
    background: rgba(17, 24, 39, 0.8);
    color: #f472b6;
  }

  /* Flagship Hero Card */
  .flagship-hero-card {
    margin: 2rem 0;
    background: linear-gradient(135deg, rgba(3, 105, 161, 0.05) 0%, rgba(147, 51, 234, 0.05) 100%);
    border: 2px solid var(--primary, #0369a1);
    border-radius: var(--radius-xl, 12px);
    overflow: hidden;
  }

  :global([data-color-scheme="dark"]) .flagship-hero-card {
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.08) 0%, rgba(168, 85, 247, 0.08) 100%);
    border-color: var(--primary, #38bdf8);
  }

  .card-crown-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 1.25rem;
    background: linear-gradient(90deg, #0369a1 0%, #7c3aed 100%);
    color: #ffffff;
    font-size: 0.825rem;
    font-weight: 700;
  }

  .crown-code {
    background: rgba(255, 255, 255, 0.2);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .flagship-inner {
    padding: 1.5rem;
  }

  .flagship-brand-title {
    font-size: 1.45rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
  }

  .brand-sub {
    font-size: 0.825rem;
    color: var(--muted-foreground, #6b7280);
    font-weight: 400;
    margin-left: 0.5rem;
  }

  .flagship-text {
    font-size: 0.925rem;
    line-height: 1.75;
    margin-bottom: 1.25rem;
    color: var(--foreground, #374151);
  }

  .flagship-plans-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 1.25rem 0;
  }

  @media (min-width: 640px) {
    .flagship-plans-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .plan-mini-card {
    padding: 1rem;
    background: var(--background, #ffffff);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: var(--radius-lg, 8px);
  }

  :global([data-color-scheme="dark"]) .plan-mini-card {
    background: rgba(31, 41, 55, 0.7);
    border-color: rgba(75, 85, 99, 0.5);
  }

  .plan-mini-card.standout {
    border-color: #7c3aed;
    background: rgba(147, 51, 234, 0.04);
  }

  .plan-role {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted-foreground, #6b7280);
  }

  .standout-tag {
    color: #7c3aed !important;
  }

  .plan-price-wrap {
    margin: 0.4rem 0 0.6rem 0;
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .plan-p {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--primary, #0369a1);
  }

  :global([data-color-scheme="dark"]) .plan-p {
    color: var(--primary, #38bdf8);
  }

  .plan-u {
    font-size: 0.8rem;
    color: var(--muted-foreground, #6b7280);
  }

  .plan-feats {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.8rem;
    color: var(--foreground, #4b5563);
    line-height: 1.6;
  }

  :global([data-color-scheme="dark"]) .plan-feats {
    color: #d1d5db;
  }

  .flagship-action-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .flagship-action-row {
      flex-direction: row;
    }
  }

  .btn-flagship-buy {
    flex: 2;
    text-align: center;
    background: linear-gradient(135deg, #0369a1 0%, #0284c7 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-lg, 8px);
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(3, 105, 161, 0.25);
    transition: transform 0.15s ease;
  }

  .btn-flagship-buy:hover {
    transform: translateY(-2px);
  }

  .btn-flagship-audit {
    flex: 1;
    text-align: center;
    background: var(--accent, #f3f4f6);
    color: var(--foreground, #111827);
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-lg, 8px);
    text-decoration: none;
  }

  .flagship-foot-note {
    margin-top: 1rem;
    font-size: 0.75rem;
    color: var(--muted-foreground, #9ca3af);
  }

  /* FAQ Accordion */
  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .faq-item {
    background: var(--background, #ffffff);
    border: 1px solid var(--border, #e5e7eb);
    border-radius: var(--radius-lg, 8px);
    overflow: hidden;
  }

  :global([data-color-scheme="dark"]) .faq-item {
