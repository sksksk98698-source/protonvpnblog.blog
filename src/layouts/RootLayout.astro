---
import "@/styles/reset.css";
import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/header/Header.astro";
import { AVAILABLE_LANG, DEFAULT_LANG, useTranslations, useLocale, type Lang } from "~/i18n";
import ScrollTop from "@/components/ScrollTop.astro";
import BaseHead from "@/components/BaseHead.astro";
import SiteConfig, { SITE_URL_WITH_BASE } from "~/site.config";
import { ClientRouter } from "astro:transitions";
import LoadingIndicator from "astro-loading-indicator/component";
import type { ImageMetadata } from "astro";

type Props = {
  lang?: Lang;
  title?: string;
  description?: string;
  image?: string | ImageMetadata;
  canonicalURL?: string | null;
  alternates?: Map<Lang | "x-default", string> | null;
  noindex?: boolean;
  languageSwitchLinks?: Map<Lang, string>;
  type?: "article" | "website" | "profile";
  authors?: string[] | string;
  publishedTime?: string;
  modifiedTime?: string;
  username?: string;
};

const currentLocale = useLocale() as Lang;
const normalizedSiteUrl = SiteConfig.siteUrl.replace(/\/+$/, "");
const defaultCanonicalURL = new URL(Astro.url.pathname, normalizedSiteUrl).href;

const {
  lang = currentLocale,
  title: headTitle,
  description: headDescription,
  image,
  canonicalURL: customCanonicalURL,
  alternates,
  noindex = false,
  languageSwitchLinks,
  type = "website",
  authors,
  publishedTime,
  modifiedTime,
  username,
} = Astro.props;

const canonicalURL = customCanonicalURL ?? defaultCanonicalURL;

const rawImage = image ?? SiteConfig.ogImage;
const imageSrc =
  typeof rawImage === "object" && rawImage !== null && "src" in rawImage ? rawImage.src : rawImage;

const ogImageUrl = imageSrc ? new URL(imageSrc, normalizedSiteUrl).href : undefined;

const t = useTranslations("common");

const siteTitle = t("site_title");
const siteDescription = t("site_description");

const title = headTitle ? `${headTitle} | ${siteTitle}` : siteTitle;
const description = headDescription ?? siteDescription;

const alternateList: { language: Lang; href: string }[] = [];
let xDefaultURL: string | null = null;

// Build SEO hreflang tags for multilingual indexing (unless page is marked noindex)
if (!noindex) {
  if (typeof alternates === "undefined") {
    // Default: assume matching URLs exist across all languages
    const langPrefixRegex = new RegExp(`^${SiteConfig.basePath}/[a-zA-Z-]+`);
    AVAILABLE_LANG.forEach((language) => {
      alternateList.push({
        language,
        href: new URL(
          Astro.url.pathname.replace(langPrefixRegex, `${SiteConfig.basePath}/${language}`),
          normalizedSiteUrl,
        ).href,
      });
    });
    xDefaultURL = new URL(
      Astro.url.pathname.replace(langPrefixRegex, `${SiteConfig.basePath}/${DEFAULT_LANG}`),
      normalizedSiteUrl,
    ).href;
  } else if (alternates) {
    // Custom alternates map provided by page (e.g. blog posts with specific slugs per lang)
    alternates.forEach((href, language) => {
      if (language === "x-default") {
        xDefaultURL = href;
      } else {
        alternateList.push({ language, href });
      }
    });
    if (!xDefaultURL) {
      xDefaultURL = alternates.get(DEFAULT_LANG) ?? canonicalURL;
    }
  }
}

// JSON-LD structured data for search engine rich results
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteTitle,
  url: normalizedSiteUrl,
  description: siteDescription,
  inLanguage: lang,
  potentialAction: {
    "@type": "SearchAction",
    target: `${normalizedSiteUrl}${SiteConfig.basePath}/${lang}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteTitle,
  alternateName: "protonVPN Network Observatory Lab",
  url: normalizedSiteUrl,
  logo: `${normalizedSiteUrl}${SiteConfig.basePath}/favicon.svg`,
  contactPoint: {
    "@type": "ContactPoint",
    email: "contact@protonvpnblog.blog",
    contactType: "customer service",
  },
};

const authorList = Array.isArray(authors)
  ? authors
  : typeof authors === "string"
    ? [authors]
    : [siteTitle];

const articleSchema =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description: description,
        url: canonicalURL,
        inLanguage: lang,
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonicalURL,
        },
        ...(ogImageUrl ? { image: ogImageUrl } : {}),
        ...(publishedTime ? { datePublished: publishedTime } : {}),
        ...(modifiedTime
          ? { dateModified: modifiedTime }
          : publishedTime
            ? { dateModified: publishedTime }
            : {}),
        author: authorList.map((a) => ({
          "@type": "Person",
          name: a,
        })),
        publisher: {
          "@type": "Organization",
          name: siteTitle,
          url: normalizedSiteUrl,
          logo: {
            "@type": "ImageObject",
            url: `${normalizedSiteUrl}${SiteConfig.basePath}/favicon.svg`,
          },
        },
      }
    : null;

// Language switch links for UI header dropdown (falls back to current path with language prefix swapped)
const switchLinks: Map<Lang, string> =
  languageSwitchLinks ??
  new Map(
    AVAILABLE_LANG.map((language) => [
      language,
      Astro.url.pathname.replace(`/${lang}`, `/${language}`),
    ]),
  );
---

<!doctype html>
<html
  lang={lang}
  data-code-theme-light={SiteConfig.codeTheme.light}
  data-code-theme-dark={SiteConfig.codeTheme.dark}
>
  <head>
    <BaseHead />
    <ClientRouter />
    <LoadingIndicator color="var(--primary)" height="0.25rem" />

    {/* Search Engine Webmaster Verification */}
    {
      (SiteConfig.googleSiteVerification || import.meta.env.GOOGLE_SITE_VERIFICATION) && (
        <meta
          name="google-site-verification"
          content={SiteConfig.googleSiteVerification || import.meta.env.GOOGLE_SITE_VERIFICATION}
        />
      )
    }
    {
      (SiteConfig.bingSiteVerification || import.meta.env.BING_SITE_VERIFICATION) && (
        <meta
          name="msvalidate.01"
          content={SiteConfig.bingSiteVerification || import.meta.env.BING_SITE_VERIFICATION}
        />
      )
    }
    {
      (SiteConfig.shenmaSiteVerification || import.meta.env.SHENMA_SITE_VERIFICATION) && (
        <meta
          name="shenma-site-verification"
          content={SiteConfig.shenmaSiteVerification || import.meta.env.SHENMA_SITE_VERIFICATION}
        />
      )
    }
    {
      (SiteConfig.baiduSiteVerification || import.meta.env.BAIDU_SITE_VERIFICATION) && (
        <meta
          name="baidu-site-verification"
          content={SiteConfig.baiduSiteVerification || import.meta.env.BAIDU_SITE_VERIFICATION}
        />
      )
    }

    {/* Microsoft Clarity */}
    {
      import.meta.env.PROD && SiteConfig.clarity?.enable && SiteConfig.clarity?.projectId && (
        <script
          type="text/javascript"
          is:inline
          set:html={`
        (function (c, l, a, r, i, t, y) {
          c[a] =
            c[a] ||
            function () {
              (c[a].q = c[a].q || []).push(arguments);
            };
          t = l.createElement(r);
          t.async = 1;
          t.src = "https://www.clarity.ms/tag/" + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", "${SiteConfig.clarity.projectId}");
      `}
        />
      )
    }

    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
      )
    }

    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    {/* Schema.org Structured Data (JSON-LD) */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
    {
      articleSchema && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
      )
    }

    {/* Open Graph / Facebook */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang} />
    <meta property="og:site_name" content={siteTitle} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {
      publishedTime && type === "article" && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      modifiedTime && type === "article" && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {
      type === "article" && typeof authors === "string" && (
        <meta property="article:author" content={authors} />
      )
    }
    {
      type === "article" &&
        Array.isArray(authors) &&
        authors.map((a) => <meta property="article:author" content={a} />)
    }
    {type === "profile" && username && <meta property="profile:username" content={username} />}

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {ogImageUrl && <meta property="twitter:image" content={ogImageUrl} />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href={`${SITE_URL_WITH_BASE}/${lang}/rss.xml`}
    />

    {/* Canonical URL */}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    {/* Alternate URL */}
    {
      !noindex &&
        alternateList.map(({ language, href }) => (
          <link rel="alternate" href={href} hreflang={language} />
        ))
    }
    {!noindex && xDefaultURL && <link rel="alternate" href={xDefaultURL} hreflang="x-default" />}
  </head>
  <body>
    <ScrollTop />
    <Header switchLinks={switchLinks} />
    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        min-height: 100dvh;
      }

      #container {
        margin-inline: auto;

        padding: var(--space-4);

        flex: 1;

        width: 100%;
        max-width: var(--content-max-width);
        box-sizing: border-box;
      }

      #container:focus {
        outline: none;
      }

      @media screen and (min-width: 1024px) {
        #container {
          padding-inline: var(--space-8);
        }
      }
    </style>
    <div class="fadeIn" id="container" transition:animate="none">
      <slot name="header" />
      <slot name="content" />
      <slot />
      <slot name="footer" />
    </div>
    <Footer />
  </body>
</html>
