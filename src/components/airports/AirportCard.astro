---
import type { AirportBrand } from "@/data/airports";
import CouponBadge from "./CouponBadge.astro";
import Link from "@/components/ui/Link.astro";

export interface Props {
  airport: AirportBrand;
  lang?: string;
  isDetailedView?: boolean;
}

const { airport, lang = "zh-Hans", isDetailedView = false } = Astro.props;

// Determine badge color
const isTop1 = airport.rank === 1 || airport.isFeatured;
const isTop3 = airport.rank <= 3;
const isIEPL = airport.lineType.includes("IEPL") || airport.lineType.includes("IPLC") || airport.lineType.includes("专线");
---

<div class={`airport-card border-shadow ${isTop1 ? "featured-top1" : isTop3 ? "featured-top3" : ""}`} id={`airport-${airport.slug}`}>
  <!-- Card Header -->
  <div class="card-header">
    <div class="header-main">
      <div class="rank-container">
        <span class={`rank-badge ${isTop1 ? "rank-1" : isTop3 ? "rank-top3" : ""}`}>
          #{airport.rank}
        </span>
        {isTop1 && <span class="badge-champion">🏆 综合第一 · 旗舰主推</span>}
      </div>
      <div class="title-wrap">
        <h3 class="brand-title">
          <Link href={`/${lang}/airports/${airport.slug}`} class="brand-link">
            {airport.name}
          </Link>
        </h3>
        <span class="est-year">{airport.establishedYear}年稳定运营</span>
      </div>
    </div>

    <div class="price-box">
      <span class="price-label">起步价</span>
      <div class="price-val">
        <span class="price-num">{airport.startingPrice}</span>
      </div>
      <span class="price-sub">{airport.billingCycleType}</span>
    </div>
  </div>

  <!-- Specs Matrix -->
  <div class="specs-bar">
    <div class="spec-item">
      <span class="spec-label">线路架构</span>
      <span class={`spec-value ${isIEPL ? "val-iepl" : ""}`}>{airport.lineType.split("（")[0]}</span>
    </div>
    {airport.maxBandwidth && (
      <div class="spec-item">
        <span class="spec-label">峰值带宽</span>
        <span class="spec-value val-bw">{airport.maxBandwidth}</span>
      </div>
    )}
    <div class="spec-item">
      <span class="spec-label">客户端生态</span>
      <span class="spec-value">{airport.hasDedicatedClient ? "自研一键端 + Clash通用" : "通用第三方订阅"}</span>
    </div>
    <div class="spec-item">
      <span class="spec-label">测速验证</span>
      <span class={`spec-value ${airport.speedtestImage ? "val-tested" : ""}`}>
        {airport.speedtestImage ? "✅ 晚高峰真机压测" : "⚡ 自动化探测已过"}
      </span>
    </div>
  </div>

  <!-- Summary -->
  <p class="brand-summary">{airport.summary}</p>

  <!-- Tags & Node Regions -->
  <div class="meta-row">
    <div class="tag-list">
      {airport.tags.map((t) => (
        <span class="feature-tag">{t}</span>
      ))}
    </div>
    <div class="regions-list">
      <span class="region-title">核心节点:</span>
      <span class="region-text">{airport.nodeRegions.slice(0, 5).join(" · ")}{airport.nodeRegions.length > 5 ? " 等" : ""}</span>
    </div>
  </div>

  <!-- Coupon & Card Actions -->
  <div class="card-footer">
    <div class="coupon-slot">
      {airport.couponCode ? (
        <CouponBadge code={airport.couponCode} discount={airport.couponDiscount} />
      ) : (
        <span class="no-coupon-tip">官方平价直销 · 无需优惠码即享底价</span>
      )}
    </div>

    <div class="action-buttons">
      <Link
        href={`/${lang}/airports/${airport.slug}`}
        class="btn-detail"
      >
        <span>深度评测报告 ↗</span>
      </Link>
      <a
        href={airport.affUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="btn-aff"
        title={`直达 ${airport.name} 官方正品注册通道`}
      >
        <span>官网直达通道 ⚡</span>
      </a>
    </div>
  </div>

  <div class="aff-disclaimer">
    <span>🛡️ 经 protonVPN 实测认证 | 官方正品链接 | 开启 100% 连通保障</span>
  </div>
</div>

<style>
  .airport-card {
    background: var(--accent);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform var(--duration), box-shadow var(--duration), border-color var(--duration);
    position: relative;
    overflow: hidden;
  }

  .airport-card:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--shadow);
  }

  /* Featured Top 1 */
  .featured-top1 {
    border-color: rgba(56, 189, 248, 0.6);
    background: linear-gradient(180deg, rgba(56, 189, 248, 0.05) 0%, var(--accent) 100%);
    box-shadow: 0 4px 20px rgba(56, 189, 248, 0.12);
  }

  .featured-top3 {
    border-color: rgba(56, 189, 248, 0.35);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .header-main {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .rank-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .rank-badge {
    font-family: var(--font-family-monospaced);
    font-weight: 800;
    font-size: 1.1rem;
    padding: 2px 8px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--foreground);
    line-height: 1.2;
  }

  .rank-1 {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #fff;
    border-color: #d97706;
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.4);
  }

  .rank-top3 {
    background: linear-gradient(135deg, #0284c7, #0369a1);
    color: #fff;
    border-color: #0369a1;
  }

  .badge-champion {
    font-size: 0.65rem;
    font-weight: 700;
    color: #f59e0b;
    white-space: nowrap;
  }

  .title-wrap {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .brand-link {
    color: var(--foreground);
    text-decoration: none;
    transition: color var(--duration);
  }

  .brand-link:hover {
    color: var(--primary);
  }

  .est-year {
    font-size: 0.75rem;
    color: var(--muted-foreground);
    margin-top: 2px;
  }

  .price-box {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-1) var(--space-3);
  }

  .price-label {
    font-size: 0.65rem;
    color: var(--muted-foreground);
  }

  .price-val {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .price-num {
    font-size: 1.15rem;
    font-weight: 800;
    color: #e11d48;
    font-family: var(--font-family-monospaced);
  }

  :global([data-color-scheme="dark"]) .price-num {
    color: #fb7185;
  }

  .price-sub {
    font-size: 0.65rem;
    color: var(--muted-foreground);
  }

  .specs-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: var(--space-2);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .spec-label {
    font-size: 0.7rem;
    color: var(--muted-foreground);
  }

  .spec-value {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .val-iepl {
    color: var(--primary);
  }

  .val-bw {
    color: #10b981;
  }

  .val-tested {
    color: #10b981;
  }

  .brand-summary {
    font-size: 0.875rem;
    color: var(--muted-foreground);
    line-height: 1.5;
    margin: 0;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .feature-tag {
    font-size: 0.7rem;
    padding: 2px 6px;
    background: rgba(0, 0, 0, 0.04);
    border-radius: 4px;
    color: var(--foreground);
  }

  :global([data-color-scheme="dark"]) .feature-tag {
    background: rgba(255, 255, 255, 0.06);
  }

  .regions-list {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
  }

  .region-title {
    color: var(--muted-foreground);
  }

  .region-text {
    color: var(--foreground);
    font-weight: 500;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border);
  }

  .coupon-slot {
    display: flex;
    align-items: center;
  }

  .no-coupon-tip {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }

  .action-buttons {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .btn-detail {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    font-size: 0.825rem;
    color: var(--foreground);
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 500;
    transition: background-color var(--duration), border-color var(--duration);
  }

  .btn-detail:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .btn-aff {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    font-size: 0.825rem;
    color: #fff;
    background: var(--primary);
    border: 1px solid var(--primary);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 600;
    box-shadow: 0 2px 6px rgba(14, 165, 233, 0.3);
    transition: opacity var(--duration), transform var(--duration);
  }

  .btn-aff:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .aff-disclaimer {
    font-size: 0.7rem;
    color: var(--muted-foreground);
    text-align: right;
    margin-top: -4px;
  }
</style>
