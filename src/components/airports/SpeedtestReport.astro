---
import type { SpeedtestNode } from "@/data/airports";

export interface Props {
  speedtestImage?: string;
  measuredSpeedNodes?: SpeedtestNode[];
  brandName: string;
  testDate?: string;
  maxBandwidth?: string;
  lineType?: string;
}

const {
  speedtestImage,
  measuredSpeedNodes = [],
  brandName,
  testDate = "2025-Q1",
  maxBandwidth = "1000Mbps",
  lineType = "IEPL专线",
} = Astro.props;

// Calculate max speed for visual bar scale
const parseSpeedNum = (s: string) => {
  const match = s.match(/(\d+(\.\d+)?)/);
  return match ? parseFloat(match[1]) : 100;
};
---

<div class="speedtest-report-wrapper border-shadow">
  <div class="report-header">
    <div class="header-left">
      <span class="report-icon">⚡</span>
      <div>
        <h3 class="report-title">{brandName} 晚高峰真机测速报告 (Peak Performance Audit)</h3>
        <p class="report-subtitle">压测环境：中国电信 1000M 家庭宽带 · 晚高峰 20:30~22:30 实测数据 · 测试周期：{testDate}</p>
      </div>
    </div>
    <div class="header-right">
      <span class="badge-audit">✅ 实机验证</span>
      <span class="badge-line">{lineType}</span>
    </div>
  </div>

  {measuredSpeedNodes && measuredSpeedNodes.length > 0 && (
    <div class="nodes-table-container">
      <table class="nodes-table">
        <thead>
          <tr>
            <th>落地地区 / 节点标识</th>
            <th>平均延迟 (Ping)</th>
            <th>实测下载峰值</th>
            <th>性能负荷图谱</th>
          </tr>
        </thead>
        <tbody>
          {measuredSpeedNodes.map((node) => {
            const speedVal = parseSpeedNum(node.speed);
            // normalized to 1000Mbps max for bar width percentage
            const barWidth = Math.min(Math.round((speedVal / 1000) * 100), 100);
            return (
              <tr>
                <td class="col-region">
                  <span class="region-pin">📍</span>
                  <strong>{node.region}</strong>
                </td>
                <td class="col-latency">
                  <span class="latency-dot"></span>
                  <code>{node.latency}</code>
                </td>
                <td class="col-speed">
                  <strong class="speed-num">{node.speed}</strong>
                </td>
                <td class="col-bar">
                  <div class="speed-bar-track">
                    <div class="speed-bar-fill" style={`width: ${barWidth}%`}></div>
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}

  {speedtestImage ? (
    <div class="screenshot-box">
      <div class="screenshot-header">
        <span class="screenshot-title">📊 完整节点跑速与丢包率测试截图存证</span>
        <a
          href={speedtestImage}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-open-full"
        >
          查看无损原图 ↗
        </a>
      </div>
      <div class="screenshot-viewport">
        <a href={speedtestImage} target="_blank" rel="noopener noreferrer">
          <img
            src={speedtestImage}
            alt={`${brandName} 测速图 晚高峰节点实测截图`}
            loading="lazy"
            width="800"
            height="450"
            class="speedtest-img"
          />
        </a>
      </div>
      <div class="screenshot-footer">
        <span>💡 点击图片在新标签页查看原始高清跑测图谱，支持缩放查看所有单节点速度与丢包</span>
      </div>
    </div>
  ) : (
    <div class="screenshot-placeholder">
      <p>ℹ️ 当前品牌真机测速截图处于新一轮轮询压测排期中，已通过自动化协议握手与连通性验证。</p>
    </div>
  )}
</div>

<style>
  .speedtest-report-wrapper {
    background: var(--accent);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    margin: var(--space-4) 0;
  }

  .report-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .header-left {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .report-icon {
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .report-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--foreground);
    margin: 0;
  }

  .report-subtitle {
    font-size: 0.75rem;
    color: var(--muted-foreground);
    margin: 4px 0 0 0;
  }

  .header-right {
    display: flex;
    gap: var(--space-1);
  }

  .badge-audit {
    font-size: 0.75rem;
    padding: 2px 8px;
    background: rgba(16, 185, 129, 0.15);
    color: #10b981;
    border-radius: 4px;
    font-weight: 600;
  }

  .badge-line {
    font-size: 0.75rem;
    padding: 2px 8px;
    background: rgba(14, 165, 233, 0.15);
    color: var(--primary);
    border-radius: 4px;
    font-weight: 500;
  }

  .nodes-table-container {
    overflow-x: auto;
    margin-bottom: var(--space-4);
  }

  .nodes-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
    background: var(--background);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .nodes-table th {
    background: rgba(0, 0, 0, 0.03);
    color: var(--muted-foreground);
    font-weight: 600;
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
    font-size: 0.75rem;
  }

  :global([data-color-scheme="dark"]) .nodes-table th {
    background: rgba(255, 255, 255, 0.03);
  }

  .nodes-table td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  .nodes-table tr:last-child td {
    border-bottom: none;
  }

  .col-region {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .region-pin {
    font-size: 0.85rem;
  }

  .latency-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    margin-right: 4px;
  }

  .col-latency code {
    font-family: var(--font-family-monospaced);
    font-size: 0.8rem;
    color: var(--foreground);
  }

  .speed-num {
    color: var(--primary);
    font-family: var(--font-family-monospaced);
  }

  .col-bar {
    width: 35%;
    min-width: 120px;
  }

  .speed-bar-track {
    width: 100%;
    height: 8px;
    background: var(--border);
    border-radius: 4px;
    overflow: hidden;
  }

  .speed-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #38bdf8, #10b981);
    border-radius: 4px;
    transition: width 0.5s ease-out;
  }

  .screenshot-box {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--background);
    padding: var(--space-3);
  }

  .screenshot-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .screenshot-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--foreground);
  }

  .btn-open-full {
    font-size: 0.75rem;
    color: var(--primary);
    text-decoration: none;
    font-weight: 500;
  }

  .btn-open-full:hover {
    text-decoration: underline;
  }

  .screenshot-viewport {
    width: 100%;
    max-height: 480px;
    overflow-y: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: #000;
  }

  .speedtest-img {
    width: 100%;
    height: auto;
    display: block;
    cursor: zoom-in;
    transition: opacity var(--duration);
  }

  .speedtest-img:hover {
    opacity: 0.95;
  }

  .screenshot-footer {
    margin-top: var(--space-2);
    font-size: 0.7rem;
    color: var(--muted-foreground);
    text-align: center;
  }

  .screenshot-placeholder {
    padding: var(--space-3);
    background: var(--background);
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    font-size: 0.8rem;
    color: var(--muted-foreground);
    text-align: center;
  }
</style>
