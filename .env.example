# 网站部署 URL
# Site deployment URL
SITE_URL=https://protonvpnblog.blog

# 子路径部署前缀（根目录部署请留空）
# Subpath deployment prefix (leave empty for root deployment)
BASE_PATH=

# Disqus 评论短域名
# Disqus comment shortname
# Disqus コメントのショートネーム
DISQUS_SHORTNAME=your_disqus_shortname

# 是否启用 Disqus
# Enable Disqus
# Disqus の有効化
DISQUS_ENABLE=true

# Microsoft Clarity 项目 ID
# Microsoft Clarity project ID
# Microsoft Clarity プロジェクト ID
CLARITY_PROJECT_ID=your_clarity_project_id

# 是否启用 Microsoft Clarity
# Enable Microsoft Clarity
# Microsoft Clarity の有効化
CLARITY_ENABLE=true

# Google 网站所有权验证（HTML 标记）
# Google site verification (HTML tag)
# Google サイトの所有権の確認（HTML タグ）
GOOGLE_SITE_VERIFICATION=your_google_site_verification_code

